{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openhoo/hoolicy/main/schemas/v1/catalog.schema.json",
  "title": "Hoolicy approved pack catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "generatedAt", "packs"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "release", "oci"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
          "oci": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

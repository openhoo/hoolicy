{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openhoo/hoolicy/main/schemas/v1/pack.schema.json",
  "title": "Hoolicy policy pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "release", "description", "rules"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "release": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "description": { "type": "string", "minLength": 1 },
    "maturity": { "enum": ["experimental", "recommended", "stable"] },
    "owner": { "type": "string", "minLength": 1 },
    "compatibilityNotes": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": { "$ref": "#/$defs/compatibilityRange" },
        "hoolicy": { "$ref": "#/$defs/compatibilityRange" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": { "enum": ["string", "string_list", "bool", "number"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "default": {}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "hoolicy.schema.json#/$defs/rule" }
    }
  },
  "$defs": {
    "compatibilityRange": {
      "type": "string",
      "pattern": "^(?:(?:>=|<=|>|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?: (?:(?:>=|<=|>|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?))*(?: \\|\\| (?:(?:>=|<=|>|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?: (?:(?:>=|<=|>|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?))*)*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "maturity": { "enum": ["recommended", "stable"] } }, "required": ["maturity"] },
      "then": { "required": ["owner", "compatibilityNotes"] }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openhoo/hoolicy/main/schemas/v1/trust.schema.json",
  "title": "Hoolicy OCI pack trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirements"],
  "properties": {
    "version": { "const": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "registry"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "registry": { "type": "string", "minLength": 3 },
          "identity": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "format": "uri" },
          "key": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["key"], "not": { "anyOf": [{ "required": ["identity"] }, { "required": ["issuer"] }] } },
          { "required": ["identity", "issuer"], "not": { "required": ["key"] } }
        ]
      }
    }
  }
}

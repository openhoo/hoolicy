{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openhoo/hoolicy/main/schemas/hoolicy.schema.json",
  "title": "Hoolicy project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "failOn": { "enum": ["info", "warning", "error"], "default": "error" },
    "waivers": { "type": "string", "default": ".hoolicy/waivers.yaml" },
    "baseline": { "type": "string", "default": ".hoolicy/baseline.json" },
    "trust": { "type": "string", "default": ".hoolicy/trust.yaml" },
    "evidence": { "type": "string", "default": ".hoolicy/evidence.yaml" },
    "requireWaiverApprover": { "type": "boolean", "default": false },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumFiles": { "type": "integer", "minimum": 1 },
        "maximumDocumentBytes": { "type": "integer", "minimum": 1 },
        "maximumFindings": { "type": "integer", "minimum": 1 },
        "maximumRuleDuration": { "type": "string", "minLength": 2 },
        "maximumTotalDuration": { "type": "string", "minLength": 2 }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "paths", "owner"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 },
          "packs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
          "parameters": { "type": "object" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
        }
      }
    },
    "parameters": { "type": "object" },
    "packs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "path": { "type": "string", "minLength": 1 },
              "with": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "git", "ref"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "git": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "subdir": { "type": "string", "minLength": 1 },
              "with": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "oci"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "oci": { "type": "string", "minLength": 1 },
              "with": { "type": "object" }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "rationale", "remediation", "severity", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "kind": { "$ref": "#/$defs/kind" },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framework", "id"],
            "properties": { "framework": { "type": "string" }, "id": { "type": "string" } }
          }
        },
        "spec": { "type": "object" }
      }
    }
  }
}
